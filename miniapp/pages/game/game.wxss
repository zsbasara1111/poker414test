/* ── 基础布局 ── */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.bg-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #050D14 0%, #0d2137 50%, #112940 100%);
}

/* ── 牌桌 ── */
.bg-table-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 580rpx;
  height: 280rpx;
}

.table-oval {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #1a4a2e 0%, #0d2a1a 70%, #061510 100%);
  border: 3rpx solid rgba(61,221,132,0.2);
  box-shadow: 0 0 60rpx rgba(61,221,132,0.1), inset 0 0 40rpx rgba(0,0,0,0.5);
}

/* ── 积分栏 ── */
.score-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 30rpx;
  background: rgba(0,0,0,0.3);
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
  z-index: 10;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.score-a .score-num { color: #3DDD84; font-size: 36rpx; font-weight: bold; }
.score-b .score-num { color: #FF5555; font-size: 36rpx; font-weight: bold; }

.score-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

.timer-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #FFD700;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 1s infinite;
}

.timer-num {
  font-size: 24rpx;
  font-weight: bold;
  color: #FFD700;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,215,0,0.4); }
  50% { box-shadow: 0 0 0 8rpx rgba(255,215,0,0); }
}

/* ── 玩家头像位置 ── */
.players-wrap {
  position: absolute;
  inset: 0;
  z-index: 5;
}

.player-slot {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.avatar-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.2);
  overflow: hidden;
  position: relative;
}

.avatar-ring.ring-glow {
  border-color: #FFD700;
  box-shadow: 0 0 16rpx rgba(255,215,0,0.7);
  animation: glow 0.8s infinite alternate;
}

@keyframes glow {
  from { box-shadow: 0 0 8rpx rgba(255,215,0,0.5); }
  to { box-shadow: 0 0 24rpx rgba(255,215,0,1); }
}

.player-slot.team-a .avatar-ring { border-color: rgba(61,221,132,0.5); }
.player-slot.team-b .avatar-ring { border-color: rgba(255,85,85,0.5); }

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.bot-icon {
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
  display: block;
  width: 100%;
  background: rgba(255,255,255,0.1);
}

.player-name {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hand-count {
  font-size: 18rpx;
  color: rgba(255,255,255,0.4);
}

/* 聊天气泡 */
.chat-bubble {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.8);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  white-space: nowrap;
  font-size: 20rpx;
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.2);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── 中央出牌区 ── */
.play-area {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 6;
  max-width: 480rpx;
}

.played-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8rpx;
}

.card-row {
  display: flex;
  flex-direction: row;
  gap: -10rpx;
}

.card-sm {
  width: 44rpx;
  height: 60rpx;
  border-radius: 6rpx;
  background: #fff;
  margin-right: -8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.4);
}

.card-rank-sm { font-size: 18rpx; font-weight: bold; color: #333; line-height: 1; }
.card-suit-sm { font-size: 16rpx; color: #333; }
.card-sm.card-♥ .card-rank-sm,
.card-sm.card-♦ .card-rank-sm { color: #e00; }
.card-sm.card-♥ .card-suit-sm,
.card-sm.card-♦ .card-suit-sm { color: #e00; }
.card-sm.card-joker { background: linear-gradient(135deg, #1a0050, #4d00b3); }
.card-sm.card-joker .card-rank-sm { color: #FFD700; }

.play-type-tag {
  font-size: 18rpx;
  color: #FFD700;
  margin-top: 6rpx;
  background: rgba(255,215,0,0.1);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.play-prompt text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.3);
}

/* ── 手牌区 ── */
.hand-area {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  height: 130rpx;
  display: flex;
  justify-content: center;
  overflow: visible;
  z-index: 10;
}

.hand-cards {
  position: relative;
  height: 130rpx;
}

.card {
  position: absolute;
  width: 72rpx;
  height: 104rpx;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 2rpx 4rpx 12rpx rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s, box-shadow 0.15s;
  cursor: pointer;
}

.card.selected {
  transform: translateY(-24rpx);
  box-shadow: 0 12rpx 24rpx rgba(255,215,0,0.5);
  border: 2rpx solid #FFD700;
}

.card-rank {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  line-height: 1;
}

.card-suit {
  font-size: 22rpx;
  color: #333;
}

.card.card-♥ .card-rank,
.card.card-♦ .card-rank { color: #e00; }
.card.card-♥ .card-suit,
.card.card-♦ .card-suit { color: #e00; }
.card.card-joker {
  background: linear-gradient(135deg, #1a0050, #4d00b3);
}
.card.card-joker .card-rank { color: #FFD700; font-size: 22rpx; }

/* ── 操作按钮 ── */
.action-bar {
  position: absolute;
  bottom: 12rpx;
  right: 20rpx;
  display: flex;
  gap: 12rpx;
  z-index: 20;
}

.action-btn {
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  border: none;
  padding: 0 24rpx;
}

.action-btn::after { border: none; }

.btn-chat {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.btn-sort {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.7);
}

.btn-play {
  background: linear-gradient(135deg, #FFD700, #FF8C00);
  color: #1a0000;
  box-shadow: 0 4rpx 16rpx rgba(255,140,0,0.4);
}

.btn-pass {
  background: rgba(255,85,85,0.2);
  color: #FF5555;
  border: 1rpx solid rgba(255,85,85,0.4);
}

/* ── 聊天面板 ── */
.chat-panel {
  position: absolute;
  bottom: 80rpx;
  right: 20rpx;
  width: 400rpx;
  z-index: 30;
}

.chat-panel-inner {
  background: rgba(5,13,20,0.95);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  overflow: hidden;
}

.phrase-list {
  height: 200rpx;
  padding: 8rpx;
}

.phrase-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.phrase-item:active {
  background: rgba(255,255,255,0.1);
}

.emoji-row {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
  gap: 4rpx;
}

.emoji-item {
  font-size: 36rpx;
  padding: 6rpx;
}

/* ── 结算弹窗 ── */
.result-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-box {
  background: linear-gradient(160deg, #050D14, #0d2137);
  border-radius: 24rpx;
  padding: 48rpx 60rpx;
  border: 1rpx solid rgba(255,215,0,0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  min-width: 400rpx;
  box-shadow: 0 0 60rpx rgba(255,215,0,0.2);
}

.result-title {
  font-size: 56rpx;
  font-weight: bold;
}

.result-title.win { color: #FFD700; }
.result-title.lose { color: rgba(255,255,255,0.5); }

.result-scores {
  display: flex;
  gap: 40rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.result-delta {
  font-size: 48rpx;
  font-weight: bold;
}

.delta-win { color: #3DDD84; }
.delta-lose { color: #FF5555; }

.result-effects {
  font-size: 24rpx;
  color: #FF5555;
}

.ready-next-btn {
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFD700, #FF8C00);
  color: #1a0000;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  margin-top: 8rpx;
}

.ready-next-btn.ready {
  background: rgba(255,215,0,0.2);
  color: #FFD700;
  border: 1rpx solid #FFD700;
}

.ready-next-btn::after { border: none; }
