.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.bg-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #050D14 0%, #0d2137 50%, #1a3a5c 100%);
}

.logo-area {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-sub {
  font-size: 28rpx;
  color: #FFD700;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.logo-title {
  font-size: 96rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 0 30rpx rgba(255,215,0,0.6);
  letter-spacing: 4rpx;
}

.logo-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

.login-btn {
  position: relative;
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FFD700, #FF8C00);
  color: #1a0000;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255,140,0,0.4);
}
