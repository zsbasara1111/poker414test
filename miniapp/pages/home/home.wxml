<view class="container">
  <!-- 背景 -->
  <view class="bg-sky"/>
  <view class="bg-ground"/>

  <!-- 用户信息卡片 -->
  <view class="user-chip">
    <image class="user-av" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '玩家'}}</text>
      <text class="user-score">积分 {{userInfo.totalScore || 0}}</text>
    </view>
    <view class="edit-btn" bindtap="editProfile">编辑</view>
  </view>

  <!-- 游戏 Logo -->
  <view class="logo-area">
    <text class="logo-sub">东 北 扑 克</text>
    <text class="logo-main">刨幺414</text>
  </view>

  <!-- 主菜单 -->
  <view class="menu-row">
    <button class="menu-btn btn-create" bindtap="createRoom">
      <text class="btn-icon">🏮</text>
      <text class="btn-text">创建房间</text>
    </button>
    <button class="menu-btn btn-join" bindtap="joinRoom">
      <text class="btn-icon">🔑</text>
      <text class="btn-text">加入房间</text>
    </button>
    <button class="menu-btn btn-match" bindtap="quickMatch">
      <text class="btn-icon">⚡</text>
      <text class="btn-text">快速匹配</text>
    </button>
  </view>
</view>
