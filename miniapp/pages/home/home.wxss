.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bg-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #050D14 0%, #0d2137 60%, #1a3a5c 100%);
}

.bg-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: linear-gradient(180deg, transparent, rgba(61,221,132,0.05));
}

/* 用户信息 */
.user-chip {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 60rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.12);
  z-index: 10;
}

.user-av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid #FFD700;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}

.user-score {
  font-size: 20rpx;
  color: #FFD700;
}

.edit-btn {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
}

/* Logo */
.logo-area {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #FFD700;
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}

.logo-main {
  font-size: 88rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 0 30rpx rgba(255,215,0,0.6);
  letter-spacing: 4rpx;
}

/* 菜单按钮 */
.menu-row {
  position: relative;
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.menu-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 28rpx;
  font-weight: bold;
  transition: transform 0.15s;
  padding: 0;
}

.menu-btn::after { border: none; }

.btn-create {
  background: linear-gradient(135deg, #1a4a2e, #3DDD84);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(61,221,132,0.3);
}

.btn-join {
  background: linear-gradient(135deg, #1a2a4a, #4d8aff);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(77,138,255,0.3);
}

.btn-match {
  background: linear-gradient(135deg, #4a2a1a, #ff8c00);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255,140,0,0.3);
}

.btn-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 26rpx;
}
